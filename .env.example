# Copy this file to .env and adjust values if needed.
# docker-compose reads .env automatically; values below are also the
# defaults baked into docker-compose.yml, so an untouched copy works as-is.

# --- PostgreSQL ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# --- Frontend ---
# Must be a URL the *browser* can reach, so it's "localhost", not the
# "backend" Docker service name used for container-to-container calls.
# To load the site from another device (e.g. a phone) on the same network,
# replace "localhost" here with your PC's LAN IP instead, e.g.
# http://192.168.1.23:8080.
VITE_API_BASE_URL=http://localhost:8080

# --- Backend CORS ---
# Origins allowed to call the API from a browser. Must match whatever
# origin the frontend is actually loaded from — if VITE_API_BASE_URL above
# uses a LAN IP for phone testing, this needs the matching LAN origin too,
# e.g. http://192.168.1.23:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
